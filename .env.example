PORT=3000

# Postgres (used by docker-compose.yml)
POSTGRES_USER=saloon
POSTGRES_PASSWORD=saloon
POSTGRES_DB=saloon
POSTGRES_PORT=5432

# Used by the app and db/migrate.ts to connect to Postgres
DATABASE_URL=postgres://saloon:saloon@localhost:5432/saloon

# Where uploaded service images are written/served from. Optional — falls
# back to <cwd>/uploads if unset. Point this at a mounted volume path in
# production so uploads survive container restarts.
# UPLOADS_DIR=/data/uploads

# Auth — generate a real secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# One-time: used by `npm run db:seed` to create the first manager account.
SEED_MANAGER_NAME=Manager
SEED_MANAGER_EMAIL=manager@vismayaunisexsalon.com
SEED_MANAGER_PASSWORD=change-me
